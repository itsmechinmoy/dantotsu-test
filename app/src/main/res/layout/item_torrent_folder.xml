<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/folderIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_round_folder_24"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/folderNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        tools:text="Season 0 - Land of Waves" />

    <TextView
        android:id="@+id/folderCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textSize="12sp"
        android:alpha="0.6"
        tools:text="6 files" />

    <ImageView
        android:id="@+id/folderChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_round_arrow_drop_down_24"
        app:tint="?attr/colorPrimary" />

</LinearLayout>
